# Restaurant OS — Next.js app
# Supabase (Project Settings → API). The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Where the Express API runs. In dev the Next.js server proxies /api/* to it.
API_PROXY_TARGET=http://localhost:4000
# Leave empty to call the API through the proxy (same origin). Set to the public API URL in production.
NEXT_PUBLIC_API_URL=

# Public URL of this site (used for QR codes shown in the admin and the homepage demo QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo table and login shown on the /demo page
NEXT_PUBLIC_DEMO_TABLE_CODE=DEMO1
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=demo@restaurantos.app
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=demo1234
