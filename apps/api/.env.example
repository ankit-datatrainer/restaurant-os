# Restaurant OS — Express API
PORT=4000
# API_PORT takes precedence over PORT (keeps the API off :3000 when a tool injects PORT for the web app)
API_PORT=4000
# Set to 127.0.0.1 when a reverse proxy on the same machine serves the API.
API_HOST=
NODE_ENV=development

# Public URL of the Next.js app. Used for QR code links and CORS.
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Optional. When set, the API talks to the database with full access (bypasses RLS)
# and the seed script can create the demo login. Never ship this key to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Demo login created by `npm run seed` (also used by the /demo page)
DEMO_ADMIN_EMAIL=demo@restaurantos.app
DEMO_ADMIN_PASSWORD=demo1234

# Web Push for order notifications (guests) and new-order alerts (staff).
# Generate once with: npx web-push generate-vapid-keys   — keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:). Defaults to APP_URL.
VAPID_SUBJECT=
